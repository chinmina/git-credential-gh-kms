# Example git config: install as ~/.gitconfig, the last file git reads that sets
# a credential helper. Requires git-credential-gh-kms on $PATH.

[credential "https://github.com"]
    # Clears only helpers from files read earlier. A helper set in a later file
    # (e.g. ~/.gitconfig after /etc/gitconfig) is still called to store the token.
    helper =
    # Checked first; git stores the minted token here after a successful get.
    # Git >= 2.41 evicts it at password_expiry_utc, so the timeout is just a ceiling.
    helper = cache --timeout=3600
    # Resolves to git-credential-gh-kms on $PATH.
    helper = gh-kms
    # One installation token covers every repo, so cache per host, not per path.
    useHttpPath = false

# Force HTTPS so the credential helper is used for all GitHub fetches.
[url "https://github.com/"]
    insteadOf = ssh://git@github.com/
    insteadOf = git@github.com:
